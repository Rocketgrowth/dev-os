# ============================================================================
# ContractIQ Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in all values.
# Never commit .env.local to version control.
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase
# ----------------------------------------------------------------------------
# Get these from: Supabase Dashboard > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=           # Project URL (e.g., https://abc123.supabase.co)
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # anon/public key - safe to expose to browser

# SERVER ONLY - Never expose to client
SUPABASE_SERVICE_ROLE_KEY=          # service_role key - full database access, bypasses RLS

# ----------------------------------------------------------------------------
# OpenAI
# ----------------------------------------------------------------------------
# Get this from: https://platform.openai.com/api-keys

# SERVER ONLY - Never expose to client
OPENAI_API_KEY=                     # OpenAI API key (sk-...)

# ----------------------------------------------------------------------------
# App Configuration
# ----------------------------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000    # Base URL of the app (update for production)

# ----------------------------------------------------------------------------
# Rate Limiting (optional - defaults shown)
# ----------------------------------------------------------------------------

# SERVER ONLY
RATE_LIMIT_AI_REQUESTS_PER_MINUTE=10         # Max AI API calls per user per minute
RATE_LIMIT_UPLOAD_REQUESTS_PER_MINUTE=5      # Max uploads per user per minute

# ----------------------------------------------------------------------------
# File Upload Limits (optional - defaults shown)
# ----------------------------------------------------------------------------

MAX_FILE_SIZE_MB=10                          # Maximum PDF file size in MB
MAX_PAGE_COUNT=200                           # Maximum pages per document
MIN_EXTRACTED_WORDS=100                      # Minimum words to accept (rejects scanned PDFs)

# ----------------------------------------------------------------------------
# Chat Limits (optional - defaults shown)
# ----------------------------------------------------------------------------

MAX_CHAT_HISTORY=100                         # Max messages to send to AI model

# ----------------------------------------------------------------------------
# OpenAI Model Configuration (optional - defaults shown)
# ----------------------------------------------------------------------------

# SERVER ONLY
OPENAI_MODEL=gpt-4o                          # Model for extraction and chat
OPENAI_EXTRACTION_TEMPERATURE=0.1            # Temperature for key term extraction
OPENAI_CHAT_TEMPERATURE=0.4                  # Temperature for chat responses
OPENAI_MAX_RETRIES=3                         # Retry attempts on API failure

# ----------------------------------------------------------------------------
# Feature Flags (optional)
# ----------------------------------------------------------------------------

NEXT_PUBLIC_ENABLE_PDF_VIEWER=true           # Enable PDF.js viewer (disable for text-only fallback)
